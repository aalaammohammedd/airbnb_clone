<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify your Airbnb account</title>
  </head>
  <body style="margin: 0; padding: 0; background: #f7f7f7; color: #484848; font-family: Arial, Helvetica, sans-serif;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background: #f7f7f7; padding: 32px 12px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width: 600px; background: #ffffff;">
            <tr>
              <td style="padding: 40px 32px 24px;">
                <div style="color: #ff385c; font-size: 24px; font-weight: 700;">airbnb</div>
                <p style="font-size: 18px; line-height: 1.5; margin: 32px 0 16px;">Hi <%= firstName %>,</p>
                <p style="font-size: 18px; line-height: 1.5; margin: 0 0 24px;">
                  Welcome to Airbnb! Enter the verification code below to confirm your email address.
                </p>
                <div style="display: inline-block; padding: 16px 24px; border-radius: 6px; background: #fff0f2; color: #ff385c; font-size: 28px; font-weight: 700; letter-spacing: 8px;">
                  <%= verificationCode %>
                </div>
                <p style="font-size: 16px; line-height: 1.5; margin: 16px 0 0;">
                  This code expires in 10 minutes.
                </p>
                <p style="font-size: 16px; line-height: 1.5; margin: 24px 0 0;">
                  If you didn't create an account, you can ignore this message.
                </p>
                <p style="font-size: 18px; line-height: 1.5; margin: 32px 0 0;">Thanks,<br />The Airbnb Team</p>
                <hr style="border: 0; border-top: 1px solid #dddddd; margin: 48px 0 32px;" />
                <p style="color: #999999; font-size: 14px; line-height: 1.5; margin: 0 0 8px;">Sent with ♥ from Airbnb</p>
                <p style="color: #999999; font-size: 14px; line-height: 1.5; margin: 0;">Airbnb, Inc., 888 Brannan St, San Francisco, CA 94103</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
